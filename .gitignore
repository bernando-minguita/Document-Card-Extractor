*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
*.egg-info/
MANIFEST
pip-wheel-metadata/

# -------------------------------------------------------- virtual envs
.venv/
venv/
env/
ENV/
.conda/
